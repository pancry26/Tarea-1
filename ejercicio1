def suma_arreglo(arr):

    total = 0

    for elemento in arr:

        total += elemento

    return total


numeros = [1, 2, 3, 4, 5]

print("La suma es:", suma_arreglo(numeros))

//C++
#include <iostream>
using namespace std;

int sumaArreglo(int arr[], int n) {
    int total = 0;
    for (int i = 0; i < n; i++) {
        total += arr[i];
    }
    return total;
}

int main() {
    int numeros[] = {1, 2, 3, 4, 5};
    int n = sizeof(numeros) / sizeof(numeros[0]);

    cout << "La suma es: " << sumaArreglo(numeros, n) << endl;

    return 0;
}

