//Java
package paquete;

public class Auto {

    public static int sumaArreglo(int[] arr) {
        int total = 0;
        for (int elemento : arr) {
            total += elemento;
        }
        return total;
    }

    public static void main(String[] args) {
        int[] numeros = {1, 2, 3, 4, 5};
        System.out.println("La suma es: " + sumaArreglo(numeros));
    }
}
