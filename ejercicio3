package paquete;

import java.util.Random;

public class EJERCICIO3 {

    public static void main(String[] args) {
        Random random = new Random();
        int[] frecuencias = new int[6];
        int lanzamientos = 20000;

        for (int i = 0; i < lanzamientos; i++) {
            int resultado = random.nextInt(6) + 1;
            frecuencias[resultado - 1]++;
        }

        System.out.println("Resultados de " + lanzamientos + " lanzamientos:\n");

        for (int cara = 0; cara < frecuencias.length; cara++) {
            double porcentaje = (frecuencias[cara] * 100.0) / lanzamientos;
            System.out.printf("Cara %d: %d veces (%.2f%%)%n", cara + 1, frecuencias[cara], porcentaje);
        }

        int suma = 0;
        for (int f : frecuencias) {
            suma += f;
        }

        System.out.println("\nTotal verificado: " + suma + " lanzamientos");
    }
}
